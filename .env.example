# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=mediashelf
POSTGRES_PASSWORD=mediashelf
POSTGRES_DB=mediashelf
DATABASE_URL=postgresql://mediashelf:mediashelf@localhost:5432/mediashelf?schema=public
# Required by Prisma (schema directUrl). Locally this matches DATABASE_URL.
# On Neon: DATABASE_URL is the pooled host (hostname contains -pooler);
# DIRECT_URL is the unpooled host (no -pooler). Both need sslmode=require.
DIRECT_URL=postgresql://mediashelf:mediashelf@localhost:5432/mediashelf?schema=public

# Backend
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Frontend
# Browser calls the Next.js `/api` proxy (same-origin → Safari-safe cookies).
NEXT_PUBLIC_API_URL=/api
# Nest upstream for the proxy + server components (Docker Compose uses http://backend:3001)
API_URL=http://localhost:3001

# Google OAuth (Phase 2)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# Use the frontend proxy path so the auth cookie is set on the frontend origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Microsoft OAuth
# Create an app registration at https://entra.microsoft.com → App registrations
# Redirect URI must be a Web platform URI matching MICROSOFT_CALLBACK_URL exactly.
# Use the frontend proxy path so the auth cookie is set on the frontend origin.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
# common = work/school + personal accounts; consumers = personal Microsoft accounts only
MICROSOFT_TENANT=common

# Auth (Phase 2)
JWT_SECRET=change-me-in-production

# TMDB (Phase 4)
# Get an API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
