# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=mediashelf
POSTGRES_PASSWORD=mediashelf
POSTGRES_DB=mediashelf
DATABASE_URL=postgresql://mediashelf:mediashelf@localhost:5432/mediashelf?schema=public

# Backend
PORT=3001
NODE_ENV=development

# Frontend
# Browser-facing API URL (also used locally for server components)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional server-side override (Docker Compose sets this to http://backend:3001)
# API_URL=http://localhost:3001

# Google OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Auth (Phase 2)
JWT_SECRET=change-me-in-production

# TMDB (Phase 3)
TMDB_API_KEY=
